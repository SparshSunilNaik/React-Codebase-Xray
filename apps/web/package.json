{
    "name": "@react-codebase-xray/web",
    "version": "1.0.0",
    "description": "Web interface for react-codebase-xray",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:client": "vite",
        "dev:server": "tsx watch server/index.ts",
        "build": "npm run build:client && npm run build:server",
        "build:client": "tsc -b && vite build",
        "build:server": "tsc -p server/tsconfig.json",
        "preview": "vite preview",
        "start": "node dist/server/index.js"
    },
    "dependencies": {
        "@react-codebase-xray/analyzer": "*",
        "@react-codebase-xray/shared": "*",
        "@xyflow/react": "^12.0.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "multer": "^1.4.5-lts.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.11",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.8"
    }
}