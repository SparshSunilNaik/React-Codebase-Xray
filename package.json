{
  "name": "react-codebase-xray",
  "version": "1.0.0",
  "description": "A fully local, open-source developer tool for analyzing React codebases",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w packages/analyzer && npm run build -w apps/web && npm run build -w packages/cli",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rimraf packages/*/dist apps/*/dist node_modules/.cache"
  },
  "keywords": [
    "react",
    "codebase",
    "analyzer",
    "dependency-graph",
    "developer-tools",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  }
}
